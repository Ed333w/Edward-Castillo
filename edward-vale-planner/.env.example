# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.

# Supabase project settings -> API. The anon key is safe to expose to the
# browser: Row Level Security in supabase/schema.sql is what actually
# protects the data, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push (generate once with: npx web-push generate-vapid-keys)
# The public key is safe for the browser bundle; the private key must only
# ever be set on the server that RUNS the Supabase Edge Function
# (Supabase Dashboard -> Edge Functions -> send-reminders -> Secrets),
# NEVER in this Next.js app's environment.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
